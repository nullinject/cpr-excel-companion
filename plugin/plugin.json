{
  "manifestVersion": 2,
  "name": "excel-companion",
  "publisher": "nullinject",
  "displayName": "Excel Companion",
  "version": "0.10.1",
  "description": "Excel 通道协议转换、监控与路由设置。出站、账号、代理及结算由 CPR 管理，无需独立网关。",
  "license": "Unlicense",
  "engines": {
    "codex-proxy-rs": ">=3.18.2, <3.19.0"
  },
  "main": "bin/cpr-excel-companion-plugin",
  "runtime": "trustedProcess",
  "contributes": {
    "management": {},
    "observer": {},
    "upstream_adapter": {
      "version": 1,
      "inputFormats": [
        "openai"
      ],
      "outputFormats": [
        "openai"
      ]
    }
  },
  "configurationSchema": {
    "type": "object",
    "title": "插件数据与页面",
    "properties": {
      "policyFile": {
        "type": "string",
        "title": "策略文件",
        "description": "插件进程可读写的绝对路径；目录需提前创建。迁移时复制旧网关的策略文件。",
        "default": "/app/.runtime/data/excel-companion/plugin-policy.json"
      },
      "showPage": {
        "type": "boolean",
        "default": true,
        "title": "显示 Excel 网关侧栏"
      }
    },
    "required": [
      "policyFile"
    ],
    "additionalProperties": false
  },
  "resources": {
    "web/index.html": "text/html",
    "web/app.js": "text/javascript",
    "web/app.css": "text/css"
  }
}
