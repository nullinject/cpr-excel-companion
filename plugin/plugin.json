{
  "manifestVersion": 1,
  "name": "excel-companion",
  "publisher": "nullinject",
  "displayName": "Excel Companion",
  "version": "0.8.2",
  "description": "官方 CPR 的 Excel 桥接适配器（数据面桥接 + 进程内控制面）",
  "license": "Unlicense",
  "engines": {
    "codex-proxy-rs": ">=3.16.0, <3.17.0"
  },
  "main": "bin/cpr-excel-companion-plugin",
  "runtime": "trustedProcess",
  "contributes": {
    "middleware": {
      "stages": [
        "attempt"
      ],
      "inputFormats": [
        "openai"
      ],
      "outputFormats": [
        "openai"
      ]
    },
    "management": {},
    "request_lifecycle": {},
    "usage": {}
  },
  "permissions": [
    "requests",
    "network",
    "models",
    "data"
  ],
  "configurationSchema": {
    "type": "object",
    "properties": {
      "secretFile": {
        "type": "string",
        "default": "/run/secrets/excel-bridge.key"
      },
      "isolationScope": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "bridgeControlUrl": {
        "type": "string",
        "default": "http://127.0.0.1:8089/_control"
      },
      "showPage": {
        "type": "boolean",
        "default": true
      }
    },
    "additionalProperties": false,
    "required": [
      "isolationScope"
    ]
  },
  "resources": {
    "web/index.html": "text/html",
    "web/app.js": "text/javascript",
    "web/app.css": "text/css"
  }
}
